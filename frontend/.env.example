# Backend API URL
# Default: http://localhost:8000 (local development)
# Production: https://api.refugio-animal.org (example)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (pk_test_... for sandbox, pk_live_... for production)
# When absent, card/SEPA payment is hidden and only bank transfer is offered.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
