# =============================================================================
# Refugio Animal Paraguay — Production Environment
# =============================================================================
# Copy this file to .env on your production server:
#   cp .env.production.template .env
# Then fill in all values marked REQUIRED.
# =============================================================================

# --- Database ---
POSTGRES_DB=refugio_prod
POSTGRES_USER=refugio_user
POSTGRES_PASSWORD=           # REQUIRED: Generate with: openssl rand -base64 32

# --- Application ---
SECRET_KEY=                  # REQUIRED: Generate with: openssl rand -base64 48
APP_ENV=production
DEBUG=false

# --- Domain & CORS ---
DOMAIN=sunstein.cloud
ALLOWED_ORIGINS=https://sunstein.cloud,https://www.sunstein.cloud

# --- Stripe (EUR donations) ---
STRIPE_SECRET_KEY=           # From: https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=       # From: stripe listen --forward-to localhost/api/webhooks/stripe

# --- Email (SMTP) ---
SMTP_ENABLED=false           # Set to true when SMTP is configured
SMTP_HOST=                   # e.g., smtp.hostinger.com or smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=               # e.g., noreply@sunstein.cloud
SMTP_PASSWORD=               # SMTP password or app-specific password
EMAIL_FROM_ADDRESS=noreply@sunstein.cloud
EMAIL_FROM_NAME=Refugio Animal Paraguay

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=60/minute

# --- Frontend (build-time, baked into JS bundle) ---
NEXT_PUBLIC_API_URL=https://sunstein.cloud/api
