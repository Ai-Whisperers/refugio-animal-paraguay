# Refugio Animal Paraguay — Environment Variables
# Copy to .env and fill in production values
# All variables have safe defaults for local development

# ── Database ──────────────────────────────────────────────
# Async SQLAlchemy URL (must use asyncpg driver)
DATABASE_URL=postgresql+asyncpg://refugio_user:refugio_pass@localhost:5432/refugio_dev

# Sync URL for Alembic migrations (uses psycopg2)
DATABASE_URL_SYNC=postgresql://refugio_user:refugio_pass@localhost:5432/refugio_dev

# ── Application ───────────────────────────────────────────
APP_ENV=development          # development | staging | production
DEBUG=false
APP_NAME=Refugio Animal Paraguay

# ── Authentication ────────────────────────────────────────
# JWT signing secret — MUST change in production (min 32 chars)
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Stripe (Payments) ────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Email (V2+) ──────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@refugioanimalparaguay.org

# ── WhatsApp (V3+) ───────────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxx
# WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Sentry (V5+) ─────────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxx

# ── CI/CD (GitHub Actions) ───────────────────────────────
# These variables are set automatically in CI workflows.
# You do not need to set them locally.
#
# CI test database (PostgreSQL 16 service container):
#   DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5432/refugio_test
#   DATABASE_URL_SYNC=postgresql://test_user:test_password@localhost:5432/refugio_test
#
# CI auth (non-production test key):
#   SECRET_KEY=ci-test-secret-key-minimum-32-characters-long
#
# CI Stripe (test-mode placeholders):
#   STRIPE_SECRET_KEY=sk_test_ci_placeholder
#   STRIPE_PUBLISHABLE_KEY=pk_test_ci_placeholder
#   STRIPE_WEBHOOK_SECRET=whsec_ci_placeholder
#
# GitHub Environments secrets (configure in repo Settings > Environments):
#   DATABASE_URL         — Production/staging database URL
#   SECRET_KEY           — Production JWT secret (min 32 chars)
#   STRIPE_SECRET_KEY    — Live Stripe secret key
#   STRIPE_WEBHOOK_SECRET — Live webhook signing secret
#
# GitHub Environments variables:
#   STAGING_URL          — Base URL for staging smoke tests
#   PRODUCTION_URL       — Base URL for production smoke tests
